# URL du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Credentials (à récupérer dans le dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique-supabase
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-privee

# Google AdSense (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console — code de verification de propriete.
# Search Console > Ajouter une propriete > Prefixe d'URL > Balise HTML :
# copiez UNIQUEMENT la valeur de content="...", pas la balise entiere.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sel du hachage des empreintes de visiteurs (compteur temps reel du back-office).
# Facultatif : a defaut, la cle service_role sert de secret, ce qui convient.
# Ne JAMAIS prefixer NEXT_PUBLIC_ : ce secret ne doit pas atteindre le navigateur.
ANALYTICS_SALT=
